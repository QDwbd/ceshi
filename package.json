{
  "name": "lucky",
  "version": "1.0.0",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev -c ./backend/tauri/tauri.conf.json",
    "dev:diff": "tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.conf.json",
    "build": "tauri build --target x86_64-pc-windows-msvc -c ./backend/tauri/tauri.conf.json",
    "build:macos": "tsx scripts/build-macos.ts",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:serve": "vite preview",
    "lint": "run-s lint:*",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint --cache .",
    "lint:styles": "stylelint --cache --allow-empty-input \"**/*.{css,scss}\"",
    "lint:ts": "tsc --noEmit",
    "lint:clippy": "cargo clippy --manifest-path ./backend/Cargo.toml --all-targets --all-features",
    "lint:rustfmt": "cargo fmt --manifest-path ./backend/Cargo.toml --all -- --check",
    "test": "run-p test:*",
    "test:backend": "cargo test --manifest-path ./backend/Cargo.toml --all-features",
    "fmt": "run-p fmt:*",
    "fmt:backend": "cargo fmt --manifest-path ./backend/Cargo.toml --all",
    "fmt:prettier": "prettier --write .",
    "check": "tsx scripts/check.ts",
    "portable": "tsx scripts/portable.ts",
    "generate:manifest": "run-p generate:manifest:*",
    "generate:manifest:latest-version": "tsx scripts/generate-latest-version.ts",
    "prepare": "husky",
    "prepare:release": "tsx scripts/prepare-release.ts"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-toml"
    ],
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "overrides": [
      {
        "files": [
          "tsconfig.json",
          "jsconfig.json"
        ],
        "options": {
          "parser": "jsonc"
        }
      }
    ]
  },
  "pnpm": {
    "overrides": {
      "vite-plugin-monaco-editor": "npm:vite-plugin-monaco-editor-new@1.1.3"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@generouted/react-router": "1.18.7",
    "@juggle/resize-observer": "3.4.0",
    "@mui/icons-material": "5.18.0",
    "@mui/lab": "5.0.0-alpha.170",
    "@mui/material": "5.18.0",
    "@mui/x-data-grid": "7.29.13",
    "@tauri-apps/api": "1.5.3",
    "ahooks": "3.9.7",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "framer-motion": "11.18.2",
    "i18next": "23.16.8",
    "lodash-es": "4.18.1",
    "monaco-editor": "0.47.0",
    "mui-color-input": "2.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.1.2",
    "react-hook-form": "7.87.0",
    "react-i18next": "14.1.3",
    "react-markdown": "9.1.0",
    "react-router-dom": "6.30.6",
    "react-transition-group": "4.4.5",
    "react-virtuoso": "4.18.12",
    "recoil": "0.7.7",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@actions/github": "6.0.1",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@tauri-apps/cli": "1.5.11",
    "@types/fs-extra": "11.0.4",
    "@types/js-cookie": "3.0.6",
    "@types/lodash-es": "4.17.12",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-transition-group": "4.4.12",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.7.0",
    "adm-zip": "0.5.12",
    "autoprefixer": "10.5.5",
    "colorize-template": "1.0.0",
    "consola": "3.4.2",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "cross-env": "7.0.3",
    "dedent": "1.7.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-config-standard": "17.1.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-html": "8.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-react": "7.37.5",
    "fs-extra": "11.4.0",
    "https-proxy-agent": "7.0.6",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "node-fetch": "3.3.2",
    "npm-run-all2": "6.2.6",
    "picocolors": "1.1.1",
    "postcss": "8.5.28",
    "postcss-html": "1.8.1",
    "postcss-import": "16.2.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.6",
    "prettier-plugin-toml": "2.0.6",
    "sass": "1.104.0",
    "shiki": "1.29.2",
    "stylelint": "16.26.1",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-recess-order": "5.1.1",
    "stylelint-config-standard": "36.0.1",
    "stylelint-declaration-block-no-ignored-properties": "2.8.0",
    "stylelint-order": "6.0.4",
    "stylelint-scss": "6.14.0",
    "telegraf": "4.16.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-monaco-editor": "1.1.0",
    "vite-plugin-sass-dts": "1.3.37",
    "vite-plugin-svgr": "4.5.0",
    "vite-tsconfig-paths": "4.3.2"
  }
}
