<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
  xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <!-- close lucky processes while install-->
    <util:CloseApplication Id="luckyCloseApp" Target="lucky.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="1">
    </util:CloseApplication>
    <util:CloseApplication Id="luckyCloseService" Target="clash-verge-service.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="1">
    </util:CloseApplication>
    <util:CloseApplication Id="luckyCloseMihomo" Target="mihomo.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="1">
    </util:CloseApplication>
    <util:CloseApplication Id="luckyCloseMihomoAlpha" Target="mihomo-alpha.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="1">
    </util:CloseApplication>
  </Fragment>
</Wix>
